{
  "name": "ialert-web",
  "version": "0.6.0",
  "description": "iAlert Web SDK: register browsers, receive Web Push while the site is closed and live messages over the iAlert Gateway and Inbox.",
  "keywords": [
    "ialert",
    "push",
    "push-notifications",
    "notifications",
    "websocket",
    "web-push"
  ],
  "homepage": "https://github.com/iAlert-ai/ialert-web#readme",
  "bugs": {
    "url": "https://github.com/iAlert-ai/ialert-web/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iAlert-ai/ialert-web.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "service-worker.js",
    "NOTICE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
